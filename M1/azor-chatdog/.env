# Konfiguracja lokalnego llama-cpp
ENGINE=LLAMA_CPP
MODEL_NAME=Gemma 3 1B Q4_K_M

# Ścieżka do modelu GGUF
# Dostępne modele:
# - gemma-3-1b-it-Q4_K_M.gguf (~600MB RAM, bardzo szybki, dobra jakość) ✅ AKTUALNY
# - gemma-2-2b-it-Q8_0.gguf (2.3GB RAM, szybki, bardzo dobra jakość)
# - Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf (5GB RAM, wolniejszy, najlepsza jakość)
LLAMA_MODEL_PATH=/Users/agnieszka/Library/Caches/llama.cpp/ggml-org_gemma-3-1b-it-GGUF_gemma-3-1b-it-Q4_K_M.gguf

# Liczba warstw GPU (dla Apple Silicon - Metal acceleration)
# Wartość -1 = wszystkie warstwy na GPU (zalecane dla Mac M1/M2/M3)
LLAMA_GPU_LAYERS=-1

# Rozmiar kontekstu (im większy, tym więcej pamięci potrzeba)
# Gemma 3 1B: zalecane 2048-4096, max 8192
# Gemma 2 2B: zalecane 4096-8192, max 8192
# Llama 3.1 8B: zalecane 4096-8192, max 32768
LLAMA_CONTEXT_SIZE=2048

# Parametry generowania
LLAMA_TEMPERATURE=0.7
LLAMA_TOP_P=0.9
LLAMA_TOP_K=40

# Konfiguracja Gemini (pozostawiona jako backup)
# ENGINE=GEMINI
# GEMINI_API_KEY="your-api-key-here"
# MODEL_NAME="gemini-2.5-flash"
